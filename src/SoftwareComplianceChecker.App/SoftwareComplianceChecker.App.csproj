<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>SoftwareComplianceChecker.App</RootNamespace>
    <AssemblyName>SoftwareComplianceChecker</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded as a resource so the window can set it explicitly. ApplicationIcon
         alone only brands the executable in Explorer. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoftwareComplianceChecker.Core\SoftwareComplianceChecker.Core.csproj" />
    <ProjectReference Include="..\SoftwareComplianceChecker.Rules\SoftwareComplianceChecker.Rules.csproj" />
    <ProjectReference Include="..\SoftwareComplianceChecker.Scanning\SoftwareComplianceChecker.Scanning.csproj" />
    <ProjectReference Include="..\SoftwareComplianceChecker.Export\SoftwareComplianceChecker.Export.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuration ships beside the executable rather than embedded, because the whole
         point of rules.json is that it can be edited without rebuilding. -->
    <Content Include="..\..\config\*.json"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
